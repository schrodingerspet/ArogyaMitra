# Database
DATABASE_URL=sqlite:///./arogya.db

# Security
SECRET_KEY=change-this-to-a-long-random-value

# App Settings
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# AI Services
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Google Services
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
YOUTUBE_API_KEY=your_youtube_key_here

# Nutrition API
SPOONACULAR_API_KEY=your_spoonacular_key_here
